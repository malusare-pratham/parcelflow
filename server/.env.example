PORT=5000
# Replace with your own MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbName>?retryWrites=true&w=majority&appName=parcelflow
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional (production): comma-separated allowlist, ex: https://app.example.com,https://admin.example.com
CLIENT_URLS=

# Optional: store uploads on Cloudinary instead of server/uploads
# (Do not commit secrets; set this in Render environment variables)
CLOUDINARY_URL=
